<?xml version="1.0" encoding="utf-8"?>
<!-- Ключи сопряжения с устройством не уходят ни в облако, ни на другой телефон -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
